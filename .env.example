NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
EMAIL_ALLOWED_DOMAIN=example.org
WEB_DEV_URL=http://localhost:5173
SESSION_SECRET=please-change-this-session-secret
DATABASE_PATH=database/data/meeting-schedule.sqlite
ORGANIZATION_NAME=示例组织

# 首次执行 db:seed 时使用。请设置为至少 12 位的独立强密码，完成初始化后及时轮换。
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

MEETING_SCHEDULE_FIRST_WEEK_START_AT=
MEETING_SCHEDULE_ACADEMIC_YEAR=2026-2027
MEETING_SCHEDULE_SEMESTER=一

# PDF
PDF_STORAGE_PATH=storage/pdf
PLAYWRIGHT_CHROMIUM_PATH=

# 填报退回邮件通知。密码应使用邮箱服务商提供的客户端专用密码或授权码。
SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@example.org
SMTP_PASSWORD=
SMTP_FROM=notifications@example.org

# 旧 Laravel/MySQL 数据迁移（仅执行迁移脚本时需要）
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_DATABASE=
LEGACY_MYSQL_USER=root
LEGACY_MYSQL_PASSWORD=
MIGRATION_DEFAULT_PASSWORD=
